<!--
This XAML file defines the structure and appearance of the "About" window.
It is a separate, non-resizable window that displays application information.
-->
<Window x:Class="ROCKNIXImageBurner.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="About ROCKNIX Image Burner"
        Height="300" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/rocknix.ico">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Logo -->
			<RowDefinition Height="Auto"/>
			<!-- Title -->
			<RowDefinition Height="Auto"/>
			<!-- Version -->
			<RowDefinition Height="Auto"/>
			<!-- Copyright -->
			<RowDefinition Height="*"/>
			<!-- Description (takes remaining space) -->
			<RowDefinition Height="Auto"/>
			<!-- Close Button -->
		</Grid.RowDefinitions>

		<Image Grid.Row="0" Source="/logo.png" Height="40" Margin="0,0,0,10"/>

		<TextBlock x:Name="TitleTextBlock" Grid.Row="1" Text="ROCKNIX Image Burner" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>

		<TextBlock x:Name="VersionTextBlock" Grid.Row="2" Text="Version: 1.0.0.0" HorizontalAlignment="Center" Margin="0,5,0,0"/>

		<TextBlock x:Name="CopyrightTextBlock" Grid.Row="3" HorizontalAlignment="Center" Margin="0,5,0,10">
			<Run Text="Copyright © 2025 "/>
			<Hyperlink NavigateUri="https://rocknix.org" RequestNavigate="Hyperlink_RequestNavigate">ROCKNIX</Hyperlink>
		</TextBlock>

		<TextBlock x:Name="DescriptionTextBlock" Grid.Row="4" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                   Text="A utility for downloading and writing ROCKNIX images to removable media."/>

		<Button x:Name="CloseButton" Grid.Row="5" Content="Close" Click="CloseButton_Click"
                Width="100" HorizontalAlignment="Center" Margin="0,15,0,0" Padding="10,5"/>
	</Grid>
</Window>