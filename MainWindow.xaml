<!--
This is the main window of the application.
- x:Class points to the code-behind file MainWindow.xaml.cs.
- Title sets the window title bar text.
- Height, Width, MinHeight, MinWidth define the size and constraints of the window.
- Icon specifies the application icon.
-->
<Window x:Class="ROCKNIXImageBurner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ROCKNIXImageBurner"
        mc:Ignorable="d"
        Title="ROCKNIX Image Burner" Height="550" Width="700" MinHeight="520" MinWidth="600" Icon="/rocknix.ico">

    <!-- The main layout container is a Grid with a 15-pixel margin. -->
    <Grid Margin="15">
        <!-- 
        The Grid is divided into rows to structure the UI vertically.
        - 'Auto' height means the row will be as tall as its content.
        - '*' height (for the spacer row) means it will take up any remaining available space.
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Logo -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Manufacturer/Device Grid -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Branch Selection -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Select Drive -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Write Button -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Download Progress -->
            <RowDefinition Height="Auto"/>
            <!-- 6: Write Progress -->
            <RowDefinition Height="*"/>
            <!-- 7: Spacer -->
            <RowDefinition Height="Auto"/>
            <!-- 8: Status Bar -->
        </Grid.RowDefinitions>

        <!-- Row 0: Logo -->
        <Image Grid.Row="0" Source="/logo.png" Height="50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Row 1: Manufacturer and Device Selection (in a nested Grid for side-by-side layout) -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="Select Manufacturer:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="ManufacturerComboBox" SelectionChanged="ManufacturerComboBox_SelectionChanged" MinHeight="30"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="Select Device:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <!-- DisplayMemberPath is set to 'Device' to show the Device property of the ImageInfo object. -->
                <ComboBox x:Name="DeviceComboBox" DisplayMemberPath="Device" SelectionChanged="DeviceComboBox_SelectionChanged" MinHeight="30"/>
            </StackPanel>
        </Grid>

        <!-- Row 2: Branch Selection -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,15">
            <TextBlock Text="Select Branch:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="BranchComboBox" SelectionChanged="BranchComboBox_SelectionChanged" MinHeight="30"/>
        </StackPanel>

        <!-- Row 3: Target Drive Selection -->
        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,15">
            <TextBlock Text="Select Target Drive:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <!-- A nested Grid is used to place the Refresh button next to the ComboBox. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="DriveComboBox" Grid.Column="0" DisplayMemberPath="DisplayString" MinHeight="30"/>
                <Button x:Name="RefreshDrivesButton" Grid.Column="1" Content="Refresh" Click="RefreshDrivesButton_Click" Margin="10,0,0,0" Padding="10,5" MinHeight="30"/>
            </Grid>
            <!-- A prominent warning about data erasure. -->
            <TextBlock Text="WARNING: Selecting a drive and writing an image will ERASE ALL DATA on the selected drive." Foreground="DarkRed" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Row 4: Write Button -->
        <Button x:Name="WriteButton" Grid.Row="4" Content="Write Image to Drive" Click="WriteButton_Click" Padding="10" FontSize="16" FontWeight="Bold" Background="#FF007ACC" Foreground="White" Margin="0,10,0,20" MinHeight="40">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <!-- A trigger to reduce opacity when the button is disabled, providing visual feedback. -->
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Row 5: Download Progress -->
        <StackPanel Grid.Row="5" Margin="0,0,0,5">
            <TextBlock Text="Download Progress:" Margin="0,0,0,2"/>
            <ProgressBar x:Name="DownloadProgressBar" Height="20" Minimum="0" Maximum="100"/>
        </StackPanel>

        <!-- Row 6: Write Progress -->
        <StackPanel Grid.Row="6" Margin="0,0,0,10">
            <TextBlock Text="Write Progress:" Margin="0,0,0,2"/>
            <ProgressBar x:Name="WriteProgressBar" Height="20" Minimum="0" Maximum="100"/>
        </StackPanel>

        <!-- Row 8: Status Bar at the bottom of the window. -->
        <StatusBar Grid.Row="8" VerticalAlignment="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
